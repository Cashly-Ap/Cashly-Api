# =================================
# LEXAND API - AWS Configuration
# =================================
# Copy to .env.aws and fill your values

# AWS Credentials
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=eu-north-1

# Elastic Beanstalk
EB_APPLICATION_NAME=Lexand-API
EB_ENVIRONMENT_NAME=Lexand-api-env

# S3 Bucket
S3_BUCKET_NAME=lexand-api-deployments
# Dedicated Base64 encoded 32-byte key; generate with openssl rand -base64 32.
# Keep stable and backed up before enrolling authenticator MFA.
MFA_ENCRYPTION_KEY=
