# Development image with hot reload via spring-boot-devtools
FROM maven:3.9.9-amazoncorretto-24

WORKDIR /app

# Install tar/gzip for Maven wrapper, inotify-tools for hot reload file watching
RUN yum update -y && yum install -y tar gzip inotify-tools && yum clean all

# Copy only what's needed for dependency caching at build time
# Uses system mvn (3.9.9) — wrapper 3.9.11 has a bug with spring-boot:run on Java 24
COPY pom.xml ./

RUN mvn dependency:go-offline -B

# Source is mounted as a bind volume at runtime (see docker-compose app-dev)
COPY src ./src

# Copy dev entrypoint script (hot reload via inotify + DevTools)
COPY scripts/dev-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/dev-entrypoint.sh

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/dev-entrypoint.sh"]
