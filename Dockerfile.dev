# Development image with hot reload via spring-boot-devtools
FROM maven:3.9.9-amazoncorretto-24

WORKDIR /app

# Install tar/gzip for Maven wrapper (amazoncorretto doesn't include them)
RUN yum update -y && yum install -y tar gzip && yum clean all

# Copy only what's needed for dependency caching at build time
COPY pom.xml ./
COPY .mvn .mvn
COPY mvnw ./

RUN chmod +x ./mvnw && ./mvnw dependency:go-offline -B

# Source is mounted as a bind volume at runtime (see docker-compose app-dev)
COPY src ./src

EXPOSE 8080

# Run without compiling tests
ENTRYPOINT ["./mvnw", "spring-boot:run", "-DskipTests", "-Dmaven.test.skip=true", "-Dsurefire.skip=true", "-DfailIfNoTests=false"]
